{
  "name": "@deliberate/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Rules engine: grid, entity store, state hash, SRD 5.1 (trimmed) rules, diff application, session recorder and replay. Pure TypeScript, no I/O, no network, seeded RNG only.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fs": {
      "types": "./src/recorder/fs-sink.ts",
      "default": "./src/recorder/fs-sink.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "replay": "node dist/recorder/cli.js replay",
    "test": "vitest run",
    "bank": "node dist/recorder/cli.js bank"
  },
  "dependencies": {
    "@deliberate/protocol": "workspace:*"
  }
}
